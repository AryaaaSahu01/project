# Copy values to your local shell or a private .env (never commit credentials).
# Local Docker Compose only; use a secret manager and TLS in production.
DATABASE_URL=postgres://journal_dev:journal_dev_only_change_me@127.0.0.1:5432/journal_dev?sslmode=disable
DB_MAX_CONNS=10
APP_ORIGIN=http://localhost:5173
API_ADDR=127.0.0.1:8080
FRONTEND_DIST=

# R2 is OPTIONAL until you provision a private bucket.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
